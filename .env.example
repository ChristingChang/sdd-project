# 複製成 .env 後填入。申請方式見 docs/line-setup.md
PORT=3001
BASE_URL=http://localhost:3001
DB_PATH=data/carpool.db

# LINE Login channel
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# LINE Messaging API channel（官方帳號，用於推播）
LINE_MESSAGING_ACCESS_TOKEN=

# 客服信箱：顯示在隱私權說明、使用須知與頁尾。正式環境（NODE_ENV=production 或 HTTPS 網址）沒設定會拒絕啟動
SUPPORT_EMAIL=

# 本機開發用：沒有 LINE 憑證時可用假登入。正式環境絕對不要開啟
DEV_LOGIN=1
